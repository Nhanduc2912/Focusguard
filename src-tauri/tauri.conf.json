{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FocusGuard",
  "version": "0.1.0",
  "identifier": "com.focusguard.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "FocusGuard",
        "width": 1024,
        "height": 740,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      },
      {
        "label": "overlay",
        "title": "FocusGuard Overlay",
        "url": "index.html?window=overlay",
        "fullscreen": true,
        "alwaysOnTop": true,
        "transparent": true,
        "decorations": false,
        "visible": false,
        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
